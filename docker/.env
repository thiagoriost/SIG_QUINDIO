# ===== MAPOTECA API =====

# Usar mapeo en docker-compose:
# PORT: ${MAPOTECA_API_PORT}
MAPOTECA_API_PORT=3000
MAPOTECA_API_NODE_ENV=production
SWAGGER_ENABLED=true
DIRECTUS_TIMEOUT=10000

# Conexion interna hacia Directus dentro de Docker network
DIRECTUS_URL=http://directus:8055
DIRECTUS_ROOT_FOLDER=Mapoteca

# Cuenta tecnica de Directus (si se requiere autenticacion desde API)
DIRECTUS_USER=
DIRECTUS_PASSWORD=


# ===== FRONT MAPOTECA (Vite) =====

VITE_MAPOTECA_PUBLIC_ORIGIN=https://sigquindio.gov.co
VITE_MAPOTECA_API_BASE=/api/v1/mapoteca
VITE_ADMIN_URL=http://localhost:8055/admin/login
VITE_VISOR_URL=


# ===== VISIT COUNTER =====

# Usar mapeo en docker-compose:
# PORT: ${VISIT_HTTPS_PORT}
# HTTP_PORT: ${VISIT_HTTP_PORT}
# VISIT_HTTP_PORT=3002
VISIT_HTTP_PORT=8055
VISIT_HTTPS_PORT=3003
ADMIN_SECRET_TOKEN=

# HTTPS/TLS
SSL_KEY_PATH=./certs/server-key.pem
SSL_CERT_PATH=./certs/server-cert.pem
SSL_CA_PATH=


# ===== VISOR =====
__VIEW_COUNTER_API_PORT__=8055
# Sin variables obligatorias en runtime con Nginx estatico.
